{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Kernel Modules",
            "type": "shell",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}/Chapter-02"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Clean Kernel Modules",
            "type": "shell",
            "command": "make clean",
            "options": {
                "cwd": "${workspaceFolder}/Chapter-02"
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
